{
    "name": "karaodin/filament-dynamic-tables",
    "description": "Supercharge Filament tables with user views, preset views, a favorites bar, quick save, a view manager, multi-column sorting, quick filters, advanced search and an advanced filter builder.",
    "keywords": [
        "karaodin",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-tables",
        "table-views",
        "saved-filters",
        "multi-sort",
        "filament-dynamic-tables"
    ],
    "homepage": "https://github.com/karaOdin/filament-dynamic-tables",
    "support": {
        "issues": "https://github.com/karaOdin/filament-dynamic-tables/issues",
        "source": "https://github.com/karaOdin/filament-dynamic-tables"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "karaOdin",
            "email": "gptchargily@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.16|^5.9",
        "filament/tables": "^4.16|^5.9",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "KaraOdin\\FilamentDynamicTables\\": "src/",
            "KaraOdin\\FilamentDynamicTables\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaraOdin\\FilamentDynamicTables\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "KaraOdin\\FilamentDynamicTables\\FilamentDynamicTablesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
